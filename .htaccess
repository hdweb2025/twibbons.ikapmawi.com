RewriteEngine On
RewriteBase /

# 1. Admin Routing (Clean URLs)
RewriteRule ^admin/login/?$ admin/login.php [L,QSA]
RewriteRule ^admin/dashboard/?$ admin/dashboard.php [L,QSA]
RewriteRule ^admin/logout/?$ admin/logout.php [L,QSA]
RewriteRule ^admin/?$ admin/dashboard.php [L,QSA]

# 2. Jika file atau direktori FISIK ada, layani langsung
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Redirect /slug/ ke /slug.php agar konsisten
RewriteRule ^([a-zA-Z0-9-]+)/$ $1.php [R=301,L]

# 4. Rewrite /slug.php (yang tidak ada fisiknya) ke index.php?event_slug=slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-zA-Z0-9-]+)\.php$ index.php?event_slug=$1 [L,QSA]

# 5. Fallback: jika /slug tanpa .php, tambahkan .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-zA-Z0-9-]+)$ $1.php [L,R=301]


